# WebSocket ค่าสดของเครื่อง LH/RH (backend: WS /api/ws/realtime)
# เว้นว่าง (แนะนำ) = ต่อผ่านโดเมนเดียวกับหน้าเว็บ แล้ว Next.js proxy ไป backend ให้ (https → wss อัตโนมัติ)
#   ใช้ได้ทั้ง localhost / tailscale / tailscale funnel โดยไม่ต้องเปิด backend ออกภายนอก
# ใส่ค่า = เบราว์เซอร์ต่อตรงไป URL นั้น (ต้องเข้าถึงได้จากเครื่องคนดู และเป็น wss:// ถ้าหน้าเว็บเป็น https)
NEXT_PUBLIC_WS_URL=

# REST base URL — เว้นว่าง = same-origin; /api/* ถูก proxy ไป BACKEND_URL ผ่าน rewrites ใน next.config.ts
# (backend ยังไม่เปิด CORS จึงไม่ควรเรียกข้ามโดเมนจากเบราว์เซอร์โดยตรง)
NEXT_PUBLIC_API_URL=

# backend ที่ Next.js proxy ไปหา ทั้ง REST และ WebSocket (ไม่ใส่ = http://127.0.0.1:8001)
# frontend อยู่คนละเครื่องกับ backend ผ่าน tailscale → ใส่ IP/ชื่อเครื่อง backend เช่น
#   BACKEND_URL=http://100.101.204.58:8001
BACKEND_URL=
