# WebSocket ค่าสดของเครื่อง LH/RH (backend: WS /api/ws/realtime)
NEXT_PUBLIC_WS_URL=ws://localhost:8001/api/ws/realtime

# REST base URL — เว้นว่าง = same-origin; /api/* ถูก proxy ไป backend (127.0.0.1:8001) ผ่าน rewrites ใน next.config.ts
# (backend ยังไม่เปิด CORS จึงไม่ควรเรียกข้ามโดเมนจากเบราว์เซอร์โดยตรง)
NEXT_PUBLIC_API_URL=
